# Optional settings for the standalone npm CLI. No .env file is required.
# The CLI does not load this file automatically; export the values you need.
# Run `basiscore-webserver init` to create the server configuration.

BASISCORE_WEBSERVER_CONFIG=./basiscore.webserver.json
REQUEST_TRACE_ENABLED=false
REQUEST_TRACE_INCLUDE_HEADERS=false
BLOCK_IP_HOST_HEADER_ENABLED=true
# ALLOWED_HOSTS=example.com,www.example.com
WEBSERVER_DISABLE_INTERNAL_FILE_SERVING=false
