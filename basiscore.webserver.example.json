{
  "Lazy": true,
  "EndPoints": {
    "public": {
      "Type": "http",
      "Addresses": [
        {
          "EndPoint": "0.0.0.0:8080"
        }
      ],
      "Active": true,
      "Routing": "gateway"
    }
  },
  "Services": {
    "gateway": {
      "Type": "http",
      "ReadBodyTimeout": 300000,
      "ProcessTimeout": 300000,
      "MaxBodySize": 50000000,
      "Settings": {
        "Connections.edge.RoutingData": {
          "endpoint": "127.0.0.1:2001"
        },
        "Default.MultiPart.CookieName": "uploadcookie"
      }
    }
  }
}
