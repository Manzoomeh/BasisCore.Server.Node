\" : param , \"userid\" : userid}])\n}\n});\nfunction loadBookmarkCommand(arg){\n\n$(\".supplier_footer_addbookmark\").find(\"i\").addClass(\"fa-heart\");\n$(\".supplier_footer_addbookmark\").find(\"i\").removeClass(\"fa-heart-o\");\n}\nfunction del_bookmark(a){\nconst userid = \"",{"Params":[{"Column":"userid","Member":"userid","Source":"db"}]},"\";\nconst pid = $(a).closest(\"li\").find(\".pid\").val()\nif(userid == 0) {\n  window.location = \"/login.bc\"\n} else {\n  $bc.setSource(\"cms.delbookmark\" , true)\n  $bc.setSource(\"db.delbookmark\", [{\"pid\" : pid , \"userid\" : userid}])\n  $(a).closest(\"li\").remove()\n}\n\n\n\n}\n\n\n$(\".star_o\").click(async function(e) {\ne.preventDefault();\n$(\".star_o\").removeClass(\"star_o_hover\")\nconst rate = $(this).attr(\"data-rate\");\n$(\"#rate_input\").val(rate)\nfor(var i = 0; i <= userid=\"=\" location=\"/login.bc\" > {\n  $(\".comments_content\").empty()\n}, 3000);\n$(\".loading_login1\").hide()\n    $(\".submit_comment span\").show()\n}\nfunction getLogin(){\nwindow.location = \"/login.bc\"\n}\n\nconst classExists = document.getElementsByClassName('slick-slide').length > 0;\n\nif (!classExists) {\n  document.getElementById('suggested_product_resize').style.display= 'none';\n}\n\nfunction checkPrice(args){\n      if(args.result.length > 0){\n    const tbl = document.getElementById(\"inventories_tbl\")\n    const tr = tbl.querySelectorAll(\"tr\")\n    tr.forEach(e => {\n        const price = e.querySelector(\".num\").innerHTML\n        const number = price.split(\" \")[0]\n        if(number == 0){\n          document.getElementById(\"add_to_basket\").removeAttribute(\"onclick\")\n          document.getElementById(\"add_to_basket\").setAttribute(\"disable\" , true)\n          document.getElementById(\"add_to_basket\").textContent=\"ناموجود\"\n          $(e).find(\".add_btn\").removeAttr(\"onclick\")\n          // e.closest(\"tr\").querySelector(\"add_btn\").removeAttribute(\"onclick\")\n          $(e).find(\".add_btn\").attr(\"disable\" , true)\n          \n        }\n    })\n    document.getElementById(\"ploading\").style.display=\"none\"\n    document.getElementById(\"inventory_wrapper\").style.display=\"block\"\n  }\n}\nfunction showLoading(){\n    \n    $(\".loading_login1\").show()\n    $(\".submit_comment span\").hide()\n}\n\n</script></body></html>"]}]}