{
  "name": "basiscore.server",
  "version": "2.0.0",
  "description": "Config-driven HTTP, HTTPS, HTTP/2, proxy, and BasisCore Edge web server for Node.js.",
  "main": "hostManager.js",
  "keywords": [
    "BasisCore",
    "ServerSide",
    "HttpServer",
    "Manzoomeh Negaran"
  ],
  "author": "Manzoomeh Negaran <info@manzoomeh.ir> (https://www.manzoomeh.ir)",
  "license": "ISC",
  "homepage": "https://github.com/Manzoomeh/BasisCore.Servre.Node",
  "bugs": {
    "url": "https://github.com/Manzoomeh/BasisCore.Servre.Node/issues"
  },
  "contributors": [
    "s.alireza qamsari <ali.qamsari@gmail.com> (https://www.linkedin.com/in/qamsari/)"
  ],
  "scripts": {
    "stage": "node ./bin/basiscore-webserver.js start",
    "start": "node ./bin/basiscore-webserver.js start",
    "validate": "node ./bin/basiscore-webserver.js validate",
    "init": "node ./bin/basiscore-webserver.js init",
    "build": "webpack --mode production",
    "dev": "node --trace-deprecation ./bin/basiscore-webserver.js start",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "manager": "node --trace-warnings manager\\index.js"
  },
  "type": "module",
  "bin": {
    "basiscore-webserver": "bin/basiscore-webserver.js"
  },
  "exports": {
    ".": "./hostManager.js"
  },
  "files": [
    "bin",
    "examples",
    "ExternalCommands",
    "Models",
    "Services",
    "edge",
    "endPoint",
    "fileStreamer",
    "modules",
    "renderEngine",
    "EndpointController.js",
    "Util.js",
    "hostManager.js"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "alasql": "^4.1.9",
    "amqplib": "^0.10.4",
    "busboy": "^1.6.0",
    "dayjs": "^1.11.6",
    "fast-xml-parser": "^4.3.2",
    "formdata-node": "^5.0.0",
    "http-status-codes": "^2.2.0",
    "iconv-lite": "^0.6.3",
    "imagemagick": "^0.1.3",
    "memorystream": "^0.3.1",
    "mime": "^4.0.3",
    "mime-db": "^1.52.0",
    "mime-types": "^2.1.35",
    "mongodb": "^6.3.0",
    "mongodb-server-3": "npm:mongodb@4.1.4",
    "mssql": "^9.3.2",
    "mysql2": "^3.6.5",
    "node-html-encoder": "^0.0.2",
    "pako": "^2.1.0",
    "promised-sqlite3": "^2.1.0",
    "querystring": "^0.2.1",
    "sharp": "^0.33.5",
    "sqlite3": "^5.1.6",
    "winston": "^3.13.0",
    "winston-transport": "^4.7.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.7",
    "babel-loader": "^9.1.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "webpack": "^5.0.0",
    "webpack-cli": "^4.0.0"
  }
}
